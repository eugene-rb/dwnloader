<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WinUI3 (Windows App SDK) 移行。旧WPF版は net8.0-windows + UseWPF/
         UseWindowsForms だったが、標準タイトルバーを保ったままのMica適用と
         トレイアイコン(H.NotifyIcon.WinUI)・クリップボード監視サブクラス化・
         Velopack pack/install/update が使い捨てプロトタイプで検証済み
         （scratchpad/winui3proto）。UseWindowsForms は使わない — WinUI3
         プロジェクトに追加すると XAML コンパイラと既知の競合(MC6000系)がある
         うえ、FolderPicker/FileOpenPicker と H.NotifyIcon.WinUI への移行で
         構造的に不要になった。 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- アンパッケージ配布。MSIXパッケージ識別を持たない代わりに、Velopackで
         これまで通り GitHub Releases からの自動更新を続ける。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Windows App SDK ランタイムのインストールを利用者に求めない。 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>Dwnldr</AssemblyName>
    <RootNamespace>Dwnldr</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 起動時のコンソール窓を出さない。selftest のときだけ自前で確保する。 -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 表示するバージョンはここ1か所に置く。vpk pack へ渡す packVersion と
         同じ値にすること（更新後に題名だけ古いまま、を防ぐ）。 -->
    <Version>2.5.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon(Win32リソース)は実行時に読めないので、トレイアイコン用に
         ファイルとしても出力にコピーする（App.GetResourceStream相当がWinUI3に無いため）。 -->
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dwnloader.Core\Dwnloader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <!-- WinUI3に標準のトレイアイコンが無いための代替。2.4.1以降はnet10.0限定に
         なりnet8.0-windowsでビルドできない（NU1202で確認済み）ため2.3.2に固定。 -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- サイトのログイン画面をアプリ内に出して Cookie を受け取る。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
