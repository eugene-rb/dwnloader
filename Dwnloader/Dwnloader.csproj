<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- WPF と WinForms を両方有効にすると、暗黙 using が両方の名前空間を
         取り込み Application / TextBox / Brush などが曖昧になる。取り込む
         名前空間は GlobalUsings.cs で明示的に決める。 -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- タスクトレイ常駐に System.Windows.Forms.NotifyIcon を使う。
         WPF には同等品が無く、追加の依存を増やさずに済む。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Dwnloader</AssemblyName>
    <RootNamespace>Dwnloader</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 起動時のコンソール窓を出さない。selftest のときだけ自前で確保する。 -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WFAC010: WinForms アナライザは高DPI設定をコード側でやれと言うが、
         このアプリの主UIは WPF なのでマニフェストで指定するのが正しい。
         トレイアイコンのためだけに WinForms を有効にしている。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- 表示するバージョンはここ1か所に置く。vpk pack へ渡す packVersion と
         同じ値にすること（更新後に題名だけ古いまま、を防ぐ）。 -->
    <Version>2.4.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon は exe の Win32 リソースに焼くだけで実行時に読めない。
         トレイアイコンも同じ絵を使うため、WPF リソースとしても埋め込む。 -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- AVIF / WebP の復号に必要。hitomi は既定で AVIF を配るため必須で、
         .NET 標準の画像デコーダも ImageSharp も AVIF を読めない。 -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <!-- JPEG を再エンコードせず PDF へ埋め込む（/DCTDecode）。Python 版の
         img2pdf と同じ性質で、画質を落とさず速い。 -->
    <PackageReference Include="PdfSharp" Version="6.2.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- サイトのログイン画面をアプリ内に出して Cookie を受け取る。ユーザーに
         DevTools を開かせたり cookies.txt を書き出させたりせずに済む。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- 受け取った Cookie は DPAPI で暗号化して保存する。auth_token は
         アカウントそのものなので、平文で置かない。.NET 8 では標準ライブラリに
         入っておらず、この小さな公式パッケージが必要。 -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
