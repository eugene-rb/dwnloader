<Window x:Class="Dwnloader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <!--
        配色は MainWindow.xaml と同じ方針: 独自の色は持たず、標準テーマ
        ブラシ (CardBackgroundFillColorDefaultBrush 等) だけで組む。
        各設定項目は Win11 設定アプリと同じ「カード」に入れてグルーピングする
        （参考: D:\Dev\Cludecode-resumer の WPF-UI 実装、ui:Card パターン）。
    -->

    <Grid Padding="20,16" Background="Transparent">
        <Grid.Resources>
            <Style x:Key="CompactPivotHeaderStyle" TargetType="PivotHeaderItem">
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="CardHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Pivot Grid.Row="0" ItemContainerStyle="{StaticResource CompactPivotHeaderStyle}">
            <PivotItem Header="保存先">
                <ScrollViewer Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="保存フォルダ" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="種類ごとに保存先を分けられます。" Style="{StaticResource CardHintStyle}" Margin="0,0,0,8"/>

                                <TextBlock Text="PDF の保存先" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputDir" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="参照" Click="PickOutput_Click" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="動画の保存先" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VideoDir" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="参照" Click="PickVideo_Click" Margin="8,0,0,0"/>
                                </Grid>

                                <TextBlock Text="音声の保存先" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AudioDir" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="参照" Click="PickAudio_Click" Margin="8,0,0,0"/>
                                </Grid>

                                <CheckBox x:Name="SiteSubfolder" Content="サイトごとにサブフォルダを作る" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="重複チェック" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Style="{StaticResource CardHintStyle}" Margin="0,0,0,8"
                                           Text="上の3つの保存先は指定しなくても常に確認します。過去に別の場所へ集めた分をここに足すと、同じものを落とし直さずに済みます。"/>

                                <TextBlock Text="追加で見るフォルダ（1行に1つ。サブフォルダも見ます）" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ScanDirs" Grid.Column="0" Height="76"
                                             AcceptsReturn="True" TextWrapping="NoWrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                    <Button Grid.Column="1" Content="追加" Click="AddScanDir_Click"
                                            VerticalAlignment="Top" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ファイル名" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="テンプレート（{title} {artist} {site} {id} {group} {series} {pages} {lang}）"
                                           Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                                <TextBox x:Name="FilenameTemplate"/>

                                <TextBlock Text="最大長" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="FilenameMaxLen" Width="120" HorizontalAlignment="Left"
                                           SpinButtonPlacementMode="Inline" SmallChange="1"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="アカウント">
                <ScrollViewer Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource CardHintStyle}"
                                   Text="ログインしておくと、R-18作品や年齢制限つきの投稿も取得できます。ボタンを押すと、いつものログイン画面がそのまま開きます。ID とパスワードを入れるだけで、あとは自動で設定されます。"/>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="pixiv" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="PixivStatus" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                                    <Button Content="ログイン" Click="PixivLogin_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    <Button Content="ログアウト" Click="PixivLogout_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="X（旧Twitter）" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="TwitterStatus" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                                    <Button Content="ログイン" Click="TwitterLogin_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    <Button Content="ログアウト" Click="TwitterLogout_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander Header="詳細設定（自分で Cookie を用意する場合）" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Margin="0,6,0,0" Spacing="2">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CardHintStyle}"
                                           Text="空のままで構いません。入力するとログインより優先されます。"/>

                                <TextBlock Text="pixiv の PHPSESSID" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="PixivCookie"/>

                                <TextBlock Text="cookies.txt（yt-dlp に渡すファイル）" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="MediaCookiesFile" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="参照" Click="PickCookies_Click" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="ダウンロード">
                <ScrollViewer Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="挙動" Style="{StaticResource CardTitleStyle}"/>
                                <CheckBox x:Name="WatchClipboard" Content="クリップボードを監視する"/>
                                <CheckBox x:Name="AutoStart" Content="検出したらすぐダウンロードを開始する"/>
                                <CheckBox x:Name="SkipDownloaded" Content="取得済みの作品は飛ばす"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="並列数とタイムアウト" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="同時にPDF化する作品数" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="GalleryWorkers" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Text="1作品内で同時に取得する画像数" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="ImageWorkers" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Text="動画・音声の同時ダウンロード数" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="VideoWorkers" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Text="リトライ回数" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="Retries" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Text="タイムアウト（秒）" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="Timeout" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>
                                <TextBlock Text="Proxy URL" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="ProxyUrl" PlaceholderText="http://127.0.0.1:8080"/>
                                <TextBlock Text="Empty uses the default system network. Supports http, https, socks4, socks4a, socks5."
                                           Style="{StaticResource CardHintStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="クリップボード監視のドメイン" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="除外ドメイン（カンマ区切り・完全一致）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="ClipboardBlacklist" Height="60"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="信頼するドメイン（除外より優先。取得に成功すると自動で増える）" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="ClipboardWhitelist" Height="60"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="画像・PDF">
                <ScrollViewer Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="画像・PDF" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="hitomi の画像形式" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="PreferFormat" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="avif"/>
                                    <ComboBoxItem Content="webp"/>
                                </ComboBox>

                                <TextBlock Text="JPEG 品質（40〜100）" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="JpegQuality" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>

                                <CheckBox x:Name="KeepImages" Content="変換前の元画像も残す" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="動画・音声">
                <ScrollViewer Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="動画・音声" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="動画の画質" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="VideoQuality" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="best"/>
                                    <ComboBoxItem Content="1080"/>
                                    <ComboBoxItem Content="720"/>
                                    <ComboBoxItem Content="480"/>
                                </ComboBox>

                                <TextBlock Text="音声の形式" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="AudioFormat" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="mp3"/>
                                    <ComboBoxItem Content="m4a"/>
                                    <ComboBoxItem Content="opus"/>
                                </ComboBox>

                                <TextBlock Text="音声のビットレート（kbps）" Style="{StaticResource FieldLabelStyle}"/>
                                <NumberBox x:Name="AudioBitrate" Width="120" HorizontalAlignment="Left" SpinButtonPlacementMode="Inline"/>

                                <CheckBox x:Name="PlaylistAll" Margin="0,12,0,0"
                                          Content="再生リスト・チャンネルは全体を取得する（オフなら先頭の1本だけ）"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="yt-dlp" Style="{StaticResource CardTitleStyle}"/>

                                <TextBlock Text="実行ファイルのパス（空なら自動検出）" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="YtDlpPath" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="参照" Click="PickYtDlp_Click" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="YtDlpStatus" Text="" Margin="0,6,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="その他">
                <ScrollViewer Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="表示・通知" Style="{StaticResource CardTitleStyle}"/>
                                <CheckBox x:Name="Notify" Content="通知を出す"/>
                                <CheckBox x:Name="MinimizeToTray" Content="閉じるボタンでタスクトレイに入れる"/>
                                <CheckBox x:Name="AlwaysOnTop" Content="常に最前面に表示する"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="更新" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="UpdateStatus" Text="" Style="{StaticResource CardHintStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="今すぐ確認" Click="CheckUpdate_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" Margin="4,4,0,0"
                                   Style="{StaticResource CardHintStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
            <Button Content="キャンセル" Click="Cancel_Click"/>
            <Button Content="保存" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
