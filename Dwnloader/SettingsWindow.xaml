<Window x:Class="Dwnloader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="600" Width="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF070A12" Foreground="#FFF4F7FF">

    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#CC111827"/>
        <SolidColorBrush x:Key="PanelHi" Color="#E6172236"/>
        <SolidColorBrush x:Key="Line" Color="#FF293752"/>
        <SolidColorBrush x:Key="LineHot" Color="#FF38D5FF"/>
        <SolidColorBrush x:Key="Muted" Color="#FF9AA8C7"/>
        <SolidColorBrush x:Key="Accent" Color="#FF38D5FF"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#CC080D18"/>
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="BorderBrush" Value="#FF334669"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,8,0,1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FF142033"/>
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Background" Value="{StaticResource PanelHi}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12" Background="#00000000">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="保存" Click="Save_Click" IsDefault="True"/>
        </StackPanel>

        <TabControl Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}">
            <TabItem Header="保存先">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="PDF の保存先"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="参照" Click="PickOutput_Click"/>
                            <TextBox x:Name="OutputDir"/>
                        </DockPanel>

                        <TextBlock Text="動画の保存先"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="参照" Click="PickVideo_Click"/>
                            <TextBox x:Name="VideoDir"/>
                        </DockPanel>

                        <TextBlock Text="音声の保存先"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="参照" Click="PickAudio_Click"/>
                            <TextBox x:Name="AudioDir"/>
                        </DockPanel>

                        <CheckBox x:Name="SiteSubfolder" Content="サイトごとにサブフォルダを作る"/>

                        <TextBlock Text="重複を調べるときに追加で見るフォルダ（1行に1つ。サブフォルダも見ます）"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="追加" Click="AddScanDir_Click"
                                    VerticalAlignment="Top"/>
                            <TextBox x:Name="ScanDirs" Height="76"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                        <TextBlock Text="上の3つの保存先は指定しなくても常に確認します。過去に別の場所へ集めた分をここに足すと、同じものを落とし直さずに済みます。"
                                   TextWrapping="Wrap" FontSize="10"/>

                        <TextBlock Text="ファイル名テンプレート（{title} {artist} {site} {id} {group} {series} {pages} {lang}）"/>
                        <TextBox x:Name="FilenameTemplate"/>

                        <TextBlock Text="ファイル名の最大長"/>
                        <TextBox x:Name="FilenameMaxLen" Width="90" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="アカウント">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="ログインしておくと、R-18作品や年齢制限つきの投稿も取得できます。ボタンを押すと、いつものログイン画面がそのまま開きます。ID とパスワードを入れるだけで、あとは自動で設定されます。"/>

                        <GroupBox Header="pixiv">
                            <StackPanel>
                                <TextBlock x:Name="PixivStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="ログイン" Click="PixivLogin_Click" Margin="0"/>
                                    <Button Content="ログアウト" Click="PixivLogout_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="X（旧Twitter）">
                            <StackPanel>
                                <TextBlock x:Name="TwitterStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="ログイン" Click="TwitterLogin_Click" Margin="0"/>
                                    <Button Content="ログアウト" Click="TwitterLogout_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="詳細設定（自分で Cookie を用意する場合）">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           Text="空のままで構いません。入力するとログインより優先されます。"/>

                                <TextBlock Text="pixiv の PHPSESSID"/>
                                <TextBox x:Name="PixivCookie"/>

                                <TextBlock Text="cookies.txt（yt-dlp に渡すファイル）"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="参照" Click="PickCookies_Click"/>
                                    <TextBox x:Name="MediaCookiesFile"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ダウンロード">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="WatchClipboard" Content="クリップボードを監視する"/>
                        <CheckBox x:Name="AutoStart" Content="検出したらすぐダウンロードを開始する"/>
                        <CheckBox x:Name="SkipDownloaded" Content="取得済みの作品は飛ばす"/>

                        <TextBlock Text="同時にPDF化する作品数"/>
                        <TextBox x:Name="GalleryWorkers" Width="90" HorizontalAlignment="Left"/>
                        <TextBlock Text="1作品内で同時に取得する画像数"/>
                        <TextBox x:Name="ImageWorkers" Width="90" HorizontalAlignment="Left"/>
                        <TextBlock Text="動画・音声の同時ダウンロード数"/>
                        <TextBox x:Name="VideoWorkers" Width="90" HorizontalAlignment="Left"/>
                        <TextBlock Text="リトライ回数"/>
                        <TextBox x:Name="Retries" Width="90" HorizontalAlignment="Left"/>
                        <TextBlock Text="タイムアウト（秒）"/>
                        <TextBox x:Name="Timeout" Width="90" HorizontalAlignment="Left"/>

                        <TextBlock Text="クリップボード監視の除外ドメイン（カンマ区切り・完全一致）"/>
                        <TextBox x:Name="ClipboardBlacklist" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="信頼するドメイン（除外より優先。取得に成功すると自動で増える）"/>
                        <TextBox x:Name="ClipboardWhitelist" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="画像・PDF">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="hitomi の画像形式（avif / webp）"/>
                        <ComboBox x:Name="PreferFormat" Width="120" HorizontalAlignment="Left">
                            <ComboBoxItem Content="avif"/>
                            <ComboBoxItem Content="webp"/>
                        </ComboBox>

                        <TextBlock Text="JPEG 品質（40〜100）"/>
                        <TextBox x:Name="JpegQuality" Width="90" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="KeepImages" Content="変換前の元画像も残す"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="動画・音声">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="動画の画質"/>
                        <ComboBox x:Name="VideoQuality" Width="120" HorizontalAlignment="Left">
                            <ComboBoxItem Content="best"/>
                            <ComboBoxItem Content="1080"/>
                            <ComboBoxItem Content="720"/>
                            <ComboBoxItem Content="480"/>
                        </ComboBox>

                        <TextBlock Text="音声の形式"/>
                        <ComboBox x:Name="AudioFormat" Width="120" HorizontalAlignment="Left">
                            <ComboBoxItem Content="mp3"/>
                            <ComboBoxItem Content="m4a"/>
                            <ComboBoxItem Content="opus"/>
                        </ComboBox>

                        <TextBlock Text="音声のビットレート（kbps）"/>
                        <TextBox x:Name="AudioBitrate" Width="90" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="PlaylistAll"
                                  Content="再生リスト・チャンネルは全体を取得する（オフなら先頭の1本だけ）"/>

                        <TextBlock Text="yt-dlp のパス（空なら自動検出）"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="参照" Click="PickYtDlp_Click"/>
                            <TextBox x:Name="YtDlpPath"/>
                        </DockPanel>
                        <TextBlock x:Name="YtDlpStatus" Text="" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="その他">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="Notify" Content="通知を出す"/>
                        <CheckBox x:Name="MinimizeToTray" Content="閉じるボタンでタスクトレイに入れる"/>
                        <CheckBox x:Name="AlwaysOnTop" Content="常に最前面に表示する"/>
                        <TextBlock Text="更新" Margin="0,16,0,1"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="今すぐ確認" Click="CheckUpdate_Click" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UpdateStatus" Text="" VerticalAlignment="Center"
                                       Margin="0"/>
                        </StackPanel>

                        <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
