<Window x:Class="Dwnloader.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ログイン" Height="760" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF14161C" Foreground="#FFE6E8EF">

    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#FF2A2E3B"/>
        <SolidColorBrush x:Key="Muted" Color="#FF9AA1B4"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FF262B38"/>
            <Setter Property="Foreground" Value="#FFE6E8EF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                       Foreground="#FFE6E8EF"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource Muted}"/>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Margin="0,0,300,0" Foreground="{StaticResource Muted}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ログインし直す" Click="Restart_Click"/>
                <Button Content="完了" Click="Done_Click" IsDefault="True"/>
                <Button Content="キャンセル" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>
    </DockPanel>
</Window>
